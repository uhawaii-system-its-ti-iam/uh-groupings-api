# aws/.env - Default non-secret configuration for aws/setup.sh
# - Loaded automatically by setup.sh when run from this directory (or via `make aws-setup`).
# - Keep secrets out of this file. The Grouper password lives in the developer's
#   overrides file (`~/.$USER-conf/uh-groupings-api-overrides.properties`); the
#   JWT signing key is generated by setup.sh. Both end up in AWS Secrets Manager.
# - Setup is non-interactive end to end: every value below must be set before
#   running `make aws-setup`, otherwise the script exits with an error.

# Required AWS deployment configuration
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=610572473041

# IAM Identity Center (SSO) configuration
# Used by the AWS scripts (via aws/lib-auth.sh) to write the CLI profile to
# ~/.aws/config and sign in on demand. These are not secrets — the start URL
# is a public portal endpoint. The SSO region is assumed to be AWS_REGION (above).
SSO_START_URL=https://d-9267e44193.awsapps.com/start
SSO_ROLE_NAME=AWSAdministratorAccess

# The AWS CLI profile name that all make aws-* targets use. This is set
# automatically when .env is sourced, so you don't need to export it separately.
AWS_PROFILE=uh-groupings

# ---------------------------------------------------------------------------
# DEPRECATED — no longer used. The API no longer has its own ALB or public
# HTTPS endpoint: access is via ECS Service Connect + the sg-api-backend
# security group. Public entry, TLS, DNS, and the certificate belong to the
# companion UI stack (Cloudflare / Cloudflare Tunnel). setup.sh no longer reads
# these keys; they are retained (blank) for history. See aws/AGENTS.md.
# ---------------------------------------------------------------------------
API_CERTIFICATE_ARN=
API_HOSTED_ZONE_ID=

# CloudFormation resource naming
#
# AWS_PROJECT_ID drives both the stack names (`${AWS_PROJECT_ID}-ecs-${AWS_ENV}`)
# and the CloudFormation `Project` parameter, which feeds into resource names
# such as `${AWS_OWNER}-${AWS_PROJECT_ID}-${AWS_ENV}-cluster`.
#
# AWS naming length limits — keep AWS_PROJECT_ID short.
#  - Application Load Balancer name: max 32 chars
#  - Target group name:              max 32 chars
#  - IAM role name:                  max 64 chars
#  - Most other resources:           max 255 chars
#
# Family of project ids (keep lengths < 14 characters):
#   - this project (Spring API):   groupings-api
#   - companion Angular UI:        groupings-aui
#   - companion React UI:          groupings-ui
#
AWS_ENV=sandbx
AWS_PROJECT_ID=groupings-api
AWS_OWNER=mhodges

# Deployment tier — SINGLE SOURCE OF TRUTH for application configuration.
# Allowed values: test | prod
#
# APP_TIER is decoupled from AWS_ENV (which only names/identifies resources).
# It is the one value that drives, together:
#   - the Spring profile the container runs: aws-<APP_TIER>  → aws-test | aws-prod
#   - the public hostname + ACM certificate selected for the ALB (see API_HOSTNAME)
#
# The shared ITS sandbox runs the test tier: AWS_ENV=sandbx + APP_TIER=test,
# which yields the aws-test profile, the grouper-test backend, and a "test"
# hostname — while resources stay named with AWS_ENV (…-sandbx-…).
# APP_TIER=prod is only permitted when AWS_ENV=prod (enforced by setup.sh).
APP_TIER=test

# Public FQDN clients use to reach the API's ALB.
# Convention (enforced by setup.sh): non-prod hostnames MUST contain "test";
# prod MUST NOT. Leave blank to keep the HTTP-only sandbox behavior (the
# LoadBalancerUrl output then falls back to the raw ALB DNS name).
# Examples: groupings-api-test.its.hawaii.edu (non-prod) / groupings-api.its.hawaii.edu (prod)
API_HOSTNAME=groupings-api-test.its.hawaii.edu

# Display name used in script output
PROJECT_NAME="UH Groupings Spring Boot API"

# Network configuration
#
# VPC_ID must reference an existing VPC with the following characteristics:
#   1. Located in the AWS_REGION specified above.
#   2. Has an Internet Gateway attached.
#   3. Its main route table contains a 0.0.0.0/0 route pointing to the IGW
#      (needed so the internet-facing ALB is reachable; the Fargate tasks
#      themselves get no public IP and reach AWS services via VPC endpoints).
#   4. Has at least two /28 CIDR ranges available for new subnets
#      (defaults: 172.18.10.16/28 and 172.18.10.32/28, sized for
#      sandbox-vpc-01 172.18.0.128/25; override via SUBNET_A_CIDR/
#      SUBNET_B_CIDR below for a different VPC).
#   5. Spans at least 2 Availability Zones in the region (required by AWS
#      for Application Load Balancers).
#
# `make aws-setup` creates two subnets inside this VPC via
# aws/cloudformation/vpc.yml and passes their IDs to the ECS stack
# automatically.
#
# The default VPC in any region satisfies all of the above out of the box.
VPC_ID=vpc-00dc91f881f96e7d0

# Main route table of the VPC. Required by the S3 Gateway endpoint in vpc.yml.
# Find it: VPC Console → Route Tables → filter by VPC_ID → the one marked "Main: Yes".
MAIN_ROUTE_TABLE_ID=rtb-030d8b0f1c92ececc

# CIDR blocks for the two subnets that vpc.yml creates.
#
# IMPORTANT: these MUST stay in agreement with the SubnetACidr / SubnetBCidr
# parameter defaults in aws/cloudformation/vpc.yml. `make aws-setup` deploys
# using the vpc.yml defaults; `make aws-check-vpc` validates using the values
# here. If they drift, the check would pass while the deploy creates different
# subnets. Update both files together.
#
# Both must fall within the VPC's CIDR block and not overlap an existing
# subnet or each other.
SUBNET_A_CIDR=172.18.10.16/28
SUBNET_B_CIDR=172.18.10.32/28

# ECS configuration
ECS_TASK_COUNT=1

# GitHub and CodePipeline configuration
# For repo https://github.com/hawaii-system-its-ti-iam/uh-groupings-api
#
# GITHUB_CONNECTION_ARN: Create a CodeConnections connection (ProviderType: GitHub)
# in the AWS Console and complete the OAuth handshake. Paste the resulting ARN here.
# The connection is shared across environments; you only need one per AWS account.
GITHUB_ORG=uhawaii-system-its-ti-iam
GITHUB_REPO=uh-groupings-api
GITHUB_BRANCH=dev-mhodges-2203
GITHUB_CONNECTION_ARN=arn:aws:codeconnections:us-west-2:610572473041:connection/ac37df3d-865b-4032-9c76-9054c7160e1a