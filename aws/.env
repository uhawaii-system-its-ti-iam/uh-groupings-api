# aws/.env - Default non-secret configuration for aws/setup.sh
# - Loaded automatically by setup.sh when run from this directory (or via `make aws-setup`).
# - Keep secrets out of this file. The Grouper password lives in the developer's
#   overrides file (`~/.$USER-conf/uh-groupings-api-overrides.properties`); the
#   JWT signing key is generated by setup.sh. Both end up in AWS Secrets Manager.
# - Setup is non-interactive end to end: every value below must be set before
#   running `make aws-setup`, otherwise the script exits with an error.

# Required AWS deployment configuration
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=610572473041

# IAM Identity Center (SSO) configuration
# Used by the AWS scripts (via aws/lib-auth.sh) to write the CLI profile to
# ~/.aws/config and sign in on demand. These are not secrets — the start URL
# is a public portal endpoint. The SSO region is assumed to be AWS_REGION (above).
SSO_START_URL=https://d-9267e44193.awsapps.com/start
SSO_ROLE_NAME=AWSAdministratorAccess

# The AWS CLI profile name that all make aws-* targets use. This is set
# automatically when .env is sourced, so you don't need to export it separately.
AWS_PROFILE=uh-groupings

# ---------------------------------------------------------------------------
# DEPRECATED — no longer used. The API has no ALB, no public HTTPS endpoint,
# and no hostname of its own: access is via ECS Service Connect + the
# sg-api-backend security group. Public entry, TLS, DNS, and the certificate
# all belong to the companion UI stack (Cloudflare / Cloudflare Tunnel).
# setup.sh no longer reads these keys; they are retained (blank) for history.
# See aws/AGENTS.md and aws/docs/aws-architecture.mmd.
# ---------------------------------------------------------------------------
API_CERTIFICATE_ARN=
API_HOSTED_ZONE_ID=
API_HOSTNAME=

# CloudFormation resource naming
#
# AWS_PROJECT_ID drives both the stack names (`${AWS_PROJECT_ID}-ecs-${AWS_ENV}`)
# and the CloudFormation `Project` parameter, which feeds into resource names
# such as `${AWS_OWNER}-${AWS_PROJECT_ID}-${AWS_ENV}-cluster`.
#
# AWS naming length limits — keep AWS_PROJECT_ID short.
#  - IAM role name:                  max 64 chars  (binding limit here)
#  - Most other resources:           max 255 chars
#
# The 32-char Application Load Balancer / target group limit no longer applies
# to this project — the API creates no load balancer. The <=13 char convention
# is retained for consistency with the companion UI projects and in case a
# length-constrained resource is introduced later.
#
# Family of project ids (keep lengths < 14 characters):
#   - this project (Spring API):   groupings-api
#   - companion Angular UI:        groupings-aui
#   - companion React UI:          groupings-ui
#
AWS_ENV=sandbx
AWS_PROJECT_ID=groupings-api
AWS_OWNER=mhodges

# Deployment tier — SINGLE SOURCE OF TRUTH for application configuration.
# Allowed values: test | prod
#
# APP_TIER is decoupled from AWS_ENV (which only names/identifies resources).
# It drives exactly one thing now that the API has no public endpoint:
#   - the Spring profile the container runs: aws-<APP_TIER>  → aws-test | aws-prod
#     which in turn selects the Grouper backend (grouper-test vs grouper),
#     app.environment, and the email on/off flags.
#
# The shared ITS sandbox runs the test tier: AWS_ENV=sandbx + APP_TIER=test,
# which yields the aws-test profile and the grouper-test backend — while
# resources stay named with AWS_ENV (…-sandbx-…).
# APP_TIER=prod is only permitted when AWS_ENV=prod (enforced by setup.sh).
#
# NOTE: hostname/certificate selection is NOT driven by APP_TIER anymore. The
# API is private (ECS Service Connect only); public DNS and TLS belong to the
# companion UI deployment.
APP_TIER=test

# Display name used in script output
PROJECT_NAME="UH Groupings Spring Boot API"

# Network configuration
#
# VPC_ID must reference an existing VPC (created and owned by the VPC team —
# never by this project) with the following characteristics:
#   1. Located in the AWS_REGION specified above.
#   2. Has one free /28 CIDR range for the API subnet (default:
#      172.18.10.16/28, sized for sandbox-vpc-01 172.18.0.128/25; override via
#      SUBNET_CIDR below for a different VPC).
#
# NOT required: an Internet Gateway, a 0.0.0.0/0 route, or a NAT gateway.
# The API creates no load balancer and needs no internet egress — the Fargate
# task runs with AssignPublicIp DISABLED and reaches AWS services through the
# VPC endpoints in vpc.yml. `make aws-check-vpc` reports IGW presence as
# informational only.
#
# Also NOT required: multiple Availability Zones. The deployment is
# SINGLE-SUBNET / SINGLE-AZ (one task). Multi-AZ HA is a deliberate future
# change requiring a second subnet in vpc.yml plus a higher ECS_TASK_COUNT.
#
# STILL PENDING: reaching on-prem Grouper WS requires a data-center path
# (Site-to-Site VPN, Transit Gateway, or Direct Connect) plus a route for the
# UH destination CIDR. The mechanism is unconfirmed — see aws/AGENTS.md,
# "Grouper WS connectivity".
#
# `make aws-setup` creates the subnet inside this VPC via
# aws/cloudformation/vpc.yml and passes its ID to the ECS stack automatically.
VPC_ID=vpc-00dc91f881f96e7d0

# Main route table of the VPC. Required by the S3 Gateway endpoint in vpc.yml.
# Find it: VPC Console → Route Tables → filter by VPC_ID → the one marked "Main: Yes".
MAIN_ROUTE_TABLE_ID=rtb-030d8b0f1c92ececc

# CIDR block for the single subnet that vpc.yml creates.
#
# IMPORTANT: this MUST stay in agreement with the SubnetCidr parameter default
# in aws/cloudformation/vpc.yml. `make aws-setup` deploys using the vpc.yml
# default; `make aws-check-vpc` validates using the value here. If they drift,
# the check would pass while the deploy creates a different subnet. Update both
# files together.
#
# Must fall within the VPC's CIDR block and not overlap an existing subnet.
SUBNET_CIDR=172.18.10.16/28

# ECS configuration
#
# One task in one subnet in one AZ. Raising this places additional tasks in the
# SAME AZ — it does not buy availability. Real multi-AZ requires adding a second
# subnet to aws/cloudformation/vpc.yml first.
ECS_TASK_COUNT=1

# GitHub and CodePipeline configuration
# For repo https://github.com/hawaii-system-its-ti-iam/uh-groupings-api
#
# GITHUB_CONNECTION_ARN: Create a CodeConnections connection (ProviderType: GitHub)
# in the AWS Console and complete the OAuth handshake. Paste the resulting ARN here.
# The connection is shared across environments; you only need one per AWS account.
GITHUB_ORG=uhawaii-system-its-ti-iam
GITHUB_REPO=uh-groupings-api
GITHUB_BRANCH=dev-mhodges-2203
GITHUB_CONNECTION_ARN=arn:aws:codeconnections:us-west-2:610572473041:connection/ac37df3d-865b-4032-9c76-9054c7160e1a